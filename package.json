{
  "name": "concrete-lead-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "automation:start": "node scripts/local-automation.mjs start",
    "automation:check": "node scripts/local-automation.mjs check",
    "automation:stop": "node scripts/local-automation.mjs stop",
    "test:integration": "node --env-file=.env --import tsx scripts/platform-integration.ts",
    "format": "prettier --write src tests scripts docs n8n README.md package.json tsconfig.json next.config.ts eslint.config.mjs",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "n8n:generate": "tsx scripts/generate-n8n-workflows.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "next-auth": "^4.24.11",
    "nodemailer": "^7.0.13",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.0"
  }
}
