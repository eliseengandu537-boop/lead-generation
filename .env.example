DATABASE_URL="postgresql://lead:localdevelopment@localhost:5432/leads?schema=public"
# Required restricted login inheriting crm_tenant. It must not own tables or bypass RLS.
TENANT_DATABASE_URL="postgresql://crm_tenant_runtime:replace@localhost:5432/leads?schema=public"
# Optional separate control pool; defaults to DATABASE_URL.
CONTROL_DATABASE_URL=""
NEXTAUTH_URL="http://localhost:3100"
NEXTAUTH_SECRET="replace-with-random-32-byte-secret"
ENCRYPTION_KEY="replace-with-64-hex-characters"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
# Browser integration is disabled unless a Turnstile secret is configured.
TURNSTILE_SECRET=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Server-only automation integration. Shared secret must be at least 32 characters.
N8N_BASE_URL=""
N8N_API_KEY=""
N8N_WEBHOOK_SECRET=""
N8N_ENCRYPTION_KEY=""
N8N_DB_PASSWORD=""
N8N_HOST=""
N8N_IMAGE=""
# Set local for a hosted app whose n8n and worker run on your computer.
ORBIT_AUTOMATION_LOCATION="hosted"
WORKER_POLL_MS="3000"
LIVE_EMAIL_ENABLED="false"
# Platform account verification/reset only. Client outreach uses each client's own OAuth account.
IDENTITY_EMAIL_PROVIDER="RESEND"
RESEND_API_KEY=""
BREVO_API_KEY=""
IDENTITY_FROM_EMAIL=""
# SMTP sends from the worker. Render Free blocks ports 465/587.
# Select IDENTITY_EMAIL_PROVIDER=SMTP and configure the worker privately.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Hosted web admission flag: set only after the local SMTP connection/send test.
IDENTITY_SMTP_READY="false"
EMAIL_VERIFICATION_URL=""
EMAIL_VERIFICATION_API_KEY=""
# Optional trusted feedback bridge. Gmail does not provide delivery/open confirmation.
EMAIL_FEEDBACK_SECRET=""
# Google Cloud OAuth client. Client sending also requires LIVE_EMAIL_ENABLED,
# an explicitly activated domain-matched account, approved n8n workflows and eligible recipients.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Prospect search and AI keys are configured per client in Website → Research connections.
# They are encrypted in PostgreSQL; never put API keys in NEXT_PUBLIC_* variables.
# Optional replacement HTTPS Overpass directory endpoint (public business search).
BUSINESS_DIRECTORY_URL="https://overpass.private.coffee/api/interpreter"
